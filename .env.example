# Copia este archivo como .env.local y llena los valores (next_steps.md §2).
# .env.local está en .gitignore: nunca subas credenciales al repo.

# Firebase Client (Firebase Console > Project Settings > Tus apps > Web)
# Son públicas: Next.js las incrusta en el JS del navegador al hacer build.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hub-aprendizaje-fes.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hub-aprendizaje-fes
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hub-aprendizaje-fes.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (del JSON de la service account). SECRETO: en producción va en Secret Manager.
FIREBASE_ADMIN_PROJECT_ID=hub-aprendizaje-fes
FIREBASE_ADMIN_CLIENT_EMAIL=hub-admin@hub-aprendizaje-fes.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vertex AI / Gemini (puede ser otro proyecto distinto al de Firebase)
GOOGLE_CLOUD_PROJECT=hub-aprendizaje-fes
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3-flash-preview
# Solo en local: JSON de una cuenta de servicio con el rol "Usuario de Vertex AI" en GOOGLE_CLOUD_PROJECT.
# En Cloud Run se deja vacío y se usa la cuenta de servicio del servicio.
VERTEX_AI_KEY_FILE=


# URL pública de la app (en local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TEMPORAL: salta el login en local (estudiante | organizador | admin). Ignorada en producción.
DEV_AUTH_BYPASS_ROLE=
